{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudBeatsS3ObjectActions",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:HeadObject"
      ],
      "Resource": "arn:aws:s3:::cloudbeats-music-storage/*"
    },
    {
      "Sid": "CloudBeatsS3BucketActions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::cloudbeats-music-storage"
    }
  ]
}

